{
  "expo": {
    "name": "RecetarioApp",
    "slug": "RecetarioApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/chef_max.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/chef_max.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f1e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/chef_max.png",
        "backgroundColor": "#0f0f1e"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.chefmax.RecetarioApp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/chef_max.png"
    }
  }
}
